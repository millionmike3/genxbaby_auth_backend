NODE_ENV=development
PORT=8080

DATABASE_URL="YOUR_EXISTING_RAILWAY_DATABASE_URL"

JWT_ACCESS_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
JWT_ISSUER="genxbaby-auth"
JWT_AUDIENCE="genxbaby-frontend"
JWT_ACCESS_TTL="15m"

REFRESH_TOKEN_DAYS=30

CORS_ORIGINS="http://localhost:3000,https://your-frontend-domain.com"

COOKIE_NAME="genxbaby_refresh"
COOKIE_SECURE=false
COOKIE_SAME_SITE="lax"
COOKIE_DOMAIN=

BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15